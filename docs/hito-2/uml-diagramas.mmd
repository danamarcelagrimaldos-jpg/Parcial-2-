sequenceDiagram
    autonumber
    actor C as Cliente (Frontend / API Client)
    participant Ctrl as PedidoController
    participant Srv as PedidoService
    participant RepoP as ProductoRepository
    participant RepoO as PedidoRepository
    participant DB as PostgreSQL / H2

    C->>Ctrl: POST /api/v1/pedidos/cliente/{clienteId}/confirmar
    Ctrl->>Srv: confirmarPedido(clienteId)
    Srv->>DB: BEGIN TRANSACTION (@Transactional)

    alt Carrito vacio (carrito.getItems().isEmpty())
        Srv-->>Ctrl: throw ReglaNegocioException("El carrito esta vacio")
        Ctrl-->>C: HTTP 422 Unprocessable Entity (ProblemDetail)
    else Carrito valido
        loop Por cada ItemCarrito
            Srv->>RepoP: findByIdForUpdate(productoId)
            RepoP->>DB: SELECT ... FOR UPDATE (PESSIMISTIC_WRITE)
            DB-->>RepoP: Producto (stockDisponible)

            alt Stock insuficiente (stockDisponible < cantidad)
                Srv->>DB: ROLLBACK
                Srv-->>Ctrl: throw StockInsuficienteException("Stock insuficiente")
                Ctrl-->>C: HTTP 409 Conflict (ProblemDetail)
            else Stock suficiente
                Srv->>RepoP: save(productoConNuevoStock)
            end
        end

        Srv->>RepoO: save(pedido [estado=CREADO])
        RepoO->>DB: INSERT INTO pedidos & detalle_pedidos
        DB-->>RepoO: Pedido guardado (ID)
        Srv->>DB: COMMIT
        Srv-->>Ctrl: PedidoResponse
        Ctrl-->>C: HTTP 201 Created (PedidoResponse)
    end
